# ==============================================================================
# NEUROGUARDIAN ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env to git (it is already in .gitignore)
# ==============================================================================

# Django Core Settings
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production!
DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
# Example: myapp.railway.app,myapp.com,www.myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# 1. GOOGLE GEMINI API KEY (For generating AI Medical Reports)
# Get it free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GOOGLE PLACES API KEY (For searching real-world nearby hospitals)
# Get it from Google Cloud Console (Enable Places API)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
